            <mxGeometry height="71.24" width="305" x="2175.9999999999995" y="910" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="noteptr_788" plantUmlBaseStyle="shape=triangle;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;direction=north;part=1;" plantUmlBaseValue="" id="tDB_KqVmMwBC0XS5eczD-794">
          <mxCell parent="tDB_KqVmMwBC0XS5eczD-793" style="shape=triangle;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;direction=north;part=1;rotation=-85;" vertex="1">
