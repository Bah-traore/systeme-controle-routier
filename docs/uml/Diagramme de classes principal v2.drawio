        <UserObject label="    Un contrôle peut commencer sans&#xa;    plaque lisible et sans véhicule&#xa;    identifié.&#xa;&#xa;    Le contrôle peut exister sans PV.&#xa;    Sa synchronisation est gérée&#xa;    indépendamment de son statut métier." plantUmlId="note_783" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="    Un contrôle peut commencer sans&#xa;    plaque lisible et sans véhicule&#xa;    identifié.&#xa;&#xa;    Le contrôle peut exister sans PV.&#xa;    Sa synchronisation est gérée&#xa;    indépendamment de son statut métier." id="tDB_KqVmMwBC0XS5eczD-791">
          <mxCell parent="tDB_KqVmMwBC0XS5eczD-1" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1">
