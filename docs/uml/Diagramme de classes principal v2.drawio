<mxfile host="Electron">
  <diagram name="Page-1" id="b-TvZNBbzbbx-m2-rKhh">
    <mxGraphModel dx="1768" dy="1054" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml ControleRoutier_Metier\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam packageStyle rectangle\nhide empty methods\n\n&#39; =====================================================\n&#39; 1. IDENTITE ET ORGANISATION\n&#39; =====================================================\n\npackage \&quot;IDENTITE ET ORGANISATION\&quot; {\n\n  class Utilisateur {\n    +id: UUID\n    +matricule: String &lt;&lt;unique&gt;&gt;\n    +nom: String\n    +prenom: String\n    +email: String\n    +telephone: String\n    +passwordHash: String\n    +statut: StatutCompte\n    +mfaActive: Boolean\n    +dateCreation: DateTime\n    +version: Integer\n  }\n\n  class Role {\n    +id: UUID\n    +code: String &lt;&lt;unique&gt;&gt;\n    +nom: String\n    +niveau: Integer\n  }\n\n  class Permission {\n    +id: UUID\n    +code: String &lt;&lt;unique&gt;&gt;\n    +ressource: String\n    +action: String\n  }\n\n  class Affectation {\n    +id: UUID\n    +dateDebut: Date\n    +dateFin: Date\n    +statut: StatutAffectation\n    +perimetre: JSON\n  }\n\n  class StructureAdministrative {\n    +id: UUID\n    +nom: String\n    +type: TypeStructure\n    +code: String &lt;&lt;unique&gt;&gt;\n    +actif: Boolean\n  }\n\n  class ZoneControle {\n    +id: UUID\n    +nom: String\n    +description: String\n    +geometrie: Polygon\n    +actif: Boolean\n  }\n\n  Utilisateur \&quot;1\&quot; -- \&quot;0..*\&quot; Affectation\n  Affectation \&quot;*\&quot; --&gt; \&quot;1\&quot; StructureAdministrative\n  Affectation \&quot;*\&quot; --&gt; \&quot;1\&quot; Role : rôle attribué\n  Role \&quot;*\&quot; -- \&quot;*\&quot; Permission\n  StructureAdministrative \&quot;1\&quot; o-- \&quot;0..*\&quot; ZoneControle\n  StructureAdministrative \&quot;0..1\&quot; &lt;-- \&quot;0..*\&quot; StructureAdministrative : parent\n\n  note right of Affectation\n    Le rôle appartient à l&#39;affectation.\n    Les droits dépendent de :\n    - l&#39;utilisateur\n    - la structure\n    - le rôle\n    - la période\n    - le périmètre autorisé\n\n    Une affectation expirée ne donne\n    plus accès aux ressources.\n  end note\n}\n\n&#39; =====================================================\n&#39; 2. PERSONNES ET PARC AUTOMOBILE\n&#39; =====================================================\n\npackage \&quot;PERSONNES ET PARC AUTOMOBILE\&quot; {\n\n  abstract class Personne {\n    +id: UUID\n    +nom: String\n    +prenom: String\n    +telephone: String\n    +adresse: String\n    +typePersonne: TypePersonne\n  }\n\n  class Conducteur {\n    +numeroPermis: String\n    +categoriePermis: String\n    +dateDelivrance: Date\n    +dateExpiration: Date\n  }\n\n  class Proprietaire {\n    +identifiantNational: String\n    +typeProprietaire: TypeProprietaire\n  }\n\n  class Vehicule {\n    +id: UUID\n    +immatriculation: String\n    +numeroChassis: String &lt;&lt;unique&gt;&gt;\n    +marque: String\n    +modele: String\n    +categorie: String\n    +typeCarburant: String\n    +statutAdministratif: String\n    +version: Integer\n  }\n\n  class Possession {\n    +id: UUID\n    +dateDebut: Date\n    +dateFin: Date\n    +referenceTransfert: String\n  }\n\n  class DocumentVehicule {\n    +id: UUID\n    +typeDocument: TypeDocument\n    +numero: String\n    +dateEmission: Date\n    +dateExpiration: Date\n    +fichier: String\n    +hashDocument: String\n  }\n\n  Personne &lt;|-- Conducteur\n  Personne &lt;|-- Proprietaire\n\n  Vehicule \&quot;1\&quot; -- \&quot;0..*\&quot; Possession\n  Proprietaire \&quot;1\&quot; -- \&quot;0..*\&quot; Possession\n  Vehicule \&quot;1\&quot; -- \&quot;0..*\&quot; DocumentVehicule\n\n  note bottom of Possession\n    Historique des propriétaires.\n    Une seule possession principale\n    active à une date donnée.\n\n    Les PV conservent un snapshot\n    du propriétaire à la date des faits.\n  end note\n\n  note bottom of DocumentVehicule\n    Le statut valide/expiré est calculé\n    à partir des dates et des règles.\n    Il n&#39;est pas stocké.\n  end note\n}\n\n&#39; =====================================================\n&#39; 3. CONTROLE ROUTIER\n&#39; =====================================================\n\npackage \&quot;CONTROLE ROUTIER\&quot; {\n\n  class MissionControle {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +dateDebut: DateTime\n    +dateFin: DateTime\n    +statut: StatutMission\n    +description: Text\n  }\n\n  class ParticipationMission {\n    +id: UUID\n    +fonction: String\n    +dateAffectation: DateTime\n    +dateFin: DateTime\n  }\n\n  class Controle {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +dateControle: DateTime\n    +position: Point\n    +statut: StatutControle\n    +observation: Text\n    +version: Integer\n  }\n\n  class IdentificationPlaque {\n    +id: UUID\n    +plaqueDetectee: String\n    +plaqueConfirmee: String\n    +scoreOCR: Decimal\n    +methode: MethodeIdentification\n    +dateIdentification: DateTime\n  }\n\n  class VerificationAdministrative {\n    +id: UUID\n    +typeVerification: String\n    +resultat: ResultatVerification\n    +dateVerification: DateTime\n    +source: String\n    +referenceExterne: String\n    +details: JSON\n  }\n\n  MissionControle \&quot;*\&quot; --&gt; \&quot;1\&quot; StructureAdministrative\n  MissionControle \&quot;*\&quot; --&gt; \&quot;1\&quot; ZoneControle\n\n  MissionControle \&quot;1\&quot; -- \&quot;0..*\&quot; ParticipationMission\n  ParticipationMission \&quot;*\&quot; --&gt; \&quot;1\&quot; Utilisateur\n\n  MissionControle \&quot;1\&quot; -- \&quot;0..*\&quot; Controle\n  Controle \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Utilisateur : agent contrôleur\n  Controle \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Vehicule\n  Controle \&quot;*\&quot; --&gt; \&quot;0..1\&quot; ZoneControle\n  Controle \&quot;1\&quot; -- \&quot;0..*\&quot; IdentificationPlaque\n  Controle \&quot;1\&quot; -- \&quot;0..*\&quot; VerificationAdministrative\n\n  note right of Controle\n    Un contrôle peut commencer sans\n    plaque lisible et sans véhicule\n    identifié.\n\n    Le contrôle peut exister sans PV.\n    Sa synchronisation est gérée\n    indépendamment de son statut métier.\n  end note\n\n  note bottom of ParticipationMission\n    Permet les équipes avec :\n    - chef de mission\n    - agent contrôleur\n    - assistant\n    - observateur\n\n    Plusieurs agents peuvent participer\n    à une même mission.\n  end note\n}\n\n&#39; =====================================================\n&#39; 4. INFRACTIONS ET REGLEMENTATION\n&#39; =====================================================\n\npackage \&quot;INFRACTIONS ET REGLEMENTATION\&quot; {\n\n  class Infraction {\n    +id: UUID\n    +code: String &lt;&lt;unique&gt;&gt;\n    +libelle: String\n    +description: Text\n    +gravite: String\n    +actif: Boolean\n  }\n\n  class TexteReglementaire {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +titre: String\n    +typeTexte: String\n  }\n\n  class VersionTexteReglementaire {\n    +id: UUID\n    +numeroVersion: String\n    +datePublication: Date\n    +dateApplication: Date\n    +dateFinApplication: Date\n    +fichierOfficiel: String\n    +hashDocument: String\n  }\n\n  class DispositionReglementaire {\n    +id: UUID\n    +article: String\n    +paragraphe: String\n    +contenu: Text\n  }\n\n  class GrilleTarifaire {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +version: String\n    +dateDebut: Date\n    +dateFin: Date\n    +statut: StatutGrille\n    +signature: String\n  }\n\n  class TarifInfraction {\n    +id: UUID\n    +montantFCFA: BigInteger\n    +categorieVehicule: String\n    +recidive: Boolean\n    +actif: Boolean\n  }\n\n  class RegleTarifaire {\n    +id: UUID\n    +code: String\n    +priorite: Integer\n    +operateur: String\n    +valeur: String\n    +montantAjustementFCFA: BigInteger\n  }\n\n  TexteReglementaire \&quot;1\&quot; -- \&quot;1..*\&quot; VersionTexteReglementaire\n  VersionTexteReglementaire \&quot;1\&quot; -- \&quot;1..*\&quot; DispositionReglementaire\n  DispositionReglementaire \&quot;*\&quot; -- \&quot;*\&quot; Infraction : fonde juridiquement\n\n  GrilleTarifaire \&quot;1\&quot; *-- \&quot;1..*\&quot; TarifInfraction\n  Infraction \&quot;1\&quot; -- \&quot;0..*\&quot; TarifInfraction\n  TarifInfraction \&quot;1\&quot; -- \&quot;0..*\&quot; RegleTarifaire\n\n  note bottom of GrilleTarifaire\n    Une grille publiée ne se modifie pas.\n    Toute évolution crée une nouvelle version.\n    Les changements nécessitent les\n    validations réglementaires requises.\n  end note\n\n  note bottom of RegleTarifaire\n    Les conditions déterminant le montant\n    sont structurées et évaluables.\n    Aucun calcul financier critique\n    ne repose sur du JSON libre.\n  end note\n}\n\n&#39; =====================================================\n&#39; 5. VERBALISATION ET OBLIGATION FINANCIERE\n&#39; =====================================================\n\npackage \&quot;VERBALISATION ET CONTRAVENTIONS\&quot; {\n\n  class ProcesVerbal {\n    +id: UUID\n    +numeroPV: String &lt;&lt;unique&gt;&gt;\n    +dateEmission: DateTime\n    +statut: StatutPV\n    +signatureAgent: String\n    +hashDocument: String\n    +version: Integer\n  }\n\n  class PartieVerbalisee {\n    +id: UUID\n    +qualite: QualitePartie\n    +nomSnapshot: String\n    +identifiantSnapshot: String\n    +adresseSnapshot: String\n  }\n\n  class LigneProcesVerbal {\n    +id: UUID\n    +libelleSnapshot: String\n    +montantAppliqueFCFA: BigInteger\n    +referenceArticleSnapshot: String\n  }\n\n  class ValidationPV {\n    +id: UUID\n    +decision: DecisionValidation\n    +motif: Text\n    +dateDecision: DateTime\n    +signature: String\n  }\n\n  class Contravention {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +dateCreation: DateTime\n    +montantDuFCFA: BigInteger\n    +statut: StatutContravention\n    +dateNotification: DateTime\n    +modeNotification: ModeNotification\n    +dateLimiteRecours: Date\n    +version: Integer\n  }\n\n  class Paiement {\n    +id: UUID\n    +referenceInterne: String &lt;&lt;unique&gt;&gt;\n    +referenceExterne: String\n    +montantFCFA: BigInteger\n    +dateInitiation: DateTime\n    +dateConfirmation: DateTime\n    +modePaiement: ModePaiement\n    +statut: StatutPaiement\n  }\n\n  class Notification {\n    +id: UUID\n    +type: TypeNotification\n    +destinataire: String\n    +dateEnvoi: DateTime\n    +dateReception: DateTime\n    +statut: StatutNotification\n    +referenceExterne: String\n  }\n\n  class DocumentOfficiel {\n    +id: UUID\n    +type: TypeDocumentOfficiel\n    +reference: String\n    +fichier: String\n    +hash: String\n    +dateGeneration: DateTime\n  }\n\n  Controle \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ProcesVerbal\n  ProcesVerbal \&quot;*\&quot; --&gt; \&quot;1\&quot; Utilisateur : agent émetteur\n\n  ProcesVerbal \&quot;1\&quot; *-- \&quot;1..*\&quot; LigneProcesVerbal\n  LigneProcesVerbal \&quot;*\&quot; --&gt; \&quot;1\&quot; Infraction\n  LigneProcesVerbal \&quot;*\&quot; --&gt; \&quot;1\&quot; TarifInfraction\n\n  ProcesVerbal \&quot;1\&quot; -- \&quot;1..*\&quot; PartieVerbalisee\n  PartieVerbalisee \&quot;*\&quot; --&gt; \&quot;1\&quot; Personne : personne concernée\n\n  ProcesVerbal \&quot;*\&quot; --&gt; \&quot;1\&quot; GrilleTarifaire : version appliquée\n\n  ProcesVerbal \&quot;1\&quot; -- \&quot;0..*\&quot; ValidationPV\n  ValidationPV \&quot;*\&quot; --&gt; \&quot;1\&quot; Utilisateur : validateur\n\n  ProcesVerbal \&quot;1\&quot; -- \&quot;0..1\&quot; Contravention\n  Contravention \&quot;1\&quot; -- \&quot;0..*\&quot; Paiement\n  Contravention \&quot;1\&quot; -- \&quot;0..*\&quot; Notification\n\n  ProcesVerbal \&quot;1\&quot; -- \&quot;0..*\&quot; DocumentOfficiel\n  Contravention \&quot;1\&quot; -- \&quot;0..*\&quot; DocumentOfficiel\n\n  note right of PartieVerbalisee\n    Distinguer notamment :\n    - conducteur\n    - propriétaire\n    - responsable légal\n    - autre personne concernée\n\n    La responsabilité effective dépend\n    du fondement juridique applicable.\n  end note\n\n  note bottom of Contravention\n    Le montant dû est déterminé\n    par les lignes du PV et les règles\n    financières applicables.\n\n    Paiements partiels autorisés\n    si le cadre réglementaire le permet.\n\n    Le délai de recours est calculé\n    depuis la notification effective,\n    selon les règles légales applicables.\n  end note\n}\n\n&#39; =====================================================\n&#39; 6. RECOURS ET DECISIONS\n&#39; =====================================================\n\npackage \&quot;RECOURS ET DECISIONS\&quot; {\n\n  class Recours {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +dateDepot: DateTime\n    +motif: Text\n    +statut: StatutRecours\n    +dateTraitement: DateTime\n    +version: Integer\n  }\n\n  class DecisionJudiciaire {\n    +id: UUID\n    +reference: String &lt;&lt;unique&gt;&gt;\n    +decision: TypeDecisionJudiciaire\n    +motivation: Text\n    +dateDecision: DateTime\n    +signature: String\n  }\n\n  class DocumentRecours {\n    +id: UUID\n    +type: String\n    +fichier: String\n    +hash: String\n    +dateDepot: DateTime\n  }\n\n  Contravention \&quot;1\&quot; -- \&quot;0..*\&quot; Recours\n  Recours \&quot;*\&quot; --&gt; \&quot;1\&quot; Personne : requérant\n  Recours \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Utilisateur : agent traitant\n\n  Recours \&quot;1\&quot; -- \&quot;0..*\&quot; DocumentRecours\n  Recours \&quot;1\&quot; -- \&quot;0..1\&quot; DecisionJudiciaire\n  DecisionJudiciaire \&quot;*\&quot; --&gt; \&quot;1\&quot; Utilisateur : autorité décisionnaire\n  DecisionJudiciaire \&quot;1\&quot; -- \&quot;0..*\&quot; DocumentOfficiel\n\n  note bottom of Recours\n    Un recours doit conserver :\n    - sa date de dépôt\n    - son fondement\n    - ses pièces\n    - son historique de traitement\n    - sa décision finale éventuelle\n  end note\n}\n\n&#39; =====================================================\n&#39; ENUMERATIONS\n&#39; =====================================================\n\nenum StatutCompte {\n  ACTIF\n  SUSPENDU\n  VERROUILLE\n  REVOQUE\n}\n\nenum StatutAffectation {\n  EN_ATTENTE\n  ACTIVE\n  SUSPENDUE\n  TERMINEE\n}\n\nenum TypeStructure {\n  NATIONAL\n  REGIONAL\n  LOCAL\n  UNITE\n}\n\nenum TypePersonne {\n  PHYSIQUE\n  MORALE\n}\n\nenum TypeProprietaire {\n  PARTICULIER\n  ENTREPRISE\n  ADMINISTRATION\n  AUTRE\n}\n\nenum TypeDocument {\n  ASSURANCE\n  VISITE_TECHNIQUE\n  CARTE_GRISE\n  AUTRE\n}\n\nenum StatutMission {\n  PLANIFIEE\n  EN_COURS\n  SUSPENDUE\n  TERMINEE\n  ANNULEE\n}\n\nenum StatutControle {\n  BROUILLON\n  EN_COURS\n  TERMINE\n  ANNULE\n}\n\nenum MethodeIdentification {\n  OCR\n  MANUELLE\n  API\n  AUTRE\n}\n\nenum ResultatVerification {\n  CONFORME\n  NON_CONFORME\n  EXPIRE\n  INVALIDE\n  INTROUVABLE\n  INDISPONIBLE\n}\n\nenum StatutGrille {\n  BROUILLON\n  EN_VALIDATION\n  APPROUVEE\n  PUBLIEE\n  EXPIREE\n  RETIREE\n}\n\nenum StatutPV {\n  BROUILLON\n  SOUMIS\n  EN_VALIDATION\n  VALIDE\n  REJETE\n  ANNULE\n  CLOTURE\n}\n\nenum QualitePartie {\n  CONDUCTEUR\n  PROPRIETAIRE\n  RESPONSABLE_LEGAL\n  AUTRE\n}\n\nenum DecisionValidation {\n  APPROUVEE\n  REJETEE\n  RETOUR_CORRECTION\n}\n\nenum StatutContravention {\n  A_NOTIFIER\n  NOTIFIEE\n  PARTIELLEMENT_PAYEE\n  PAYEE\n  EN_RECOURS\n  SUSPENDUE\n  ANNULEE\n  EN_RETARD\n}\n\nenum ModeNotification {\n  SMS\n  EMAIL\n  COURRIER\n  REMISE_PHYSIQUE\n  AUTRE\n}\n\nenum ModePaiement {\n  ESPECES\n  ORANGE_MONEY\n  MOOV_MONEY\n  BANQUE\n  AUTRE\n}\n\nenum StatutPaiement {\n  INITIE\n  EN_ATTENTE\n  CONFIRME\n  ECHOUE\n  ANNULE\n  REMBOURSE\n}\n\nenum TypeNotification {\n  SMS\n  EMAIL\n  COURRIER\n  APPLICATION\n}\n\nenum StatutNotification {\n  PREPAREE\n  ENVOYEE\n  DELIVREE\n  ECHEC\n}\n\nenum StatutRecours {\n  DEPOSE\n  RECEVABLE\n  IRRECEVABLE\n  EN_INSTRUCTION\n  TRANSMIS\n  DECIDE\n  CLOTURE\n}\n\nenum TypeDecisionJudiciaire {\n  CONFIRMATION\n  ANNULATION\n  REDUCTION\n  AUTRE\n}\n\nnote \&quot;REGLES GENERALES\\n\\n1. Les montants sont exprimés en FCFA entiers, sous réserve de confirmation des règles de calcul.\\n2. Le montant dû doit être cohérent avec les lignes du PV et les éventuels ajustements autorisés.\\n3. Une immatriculation est unique sur sa période de validité, pas nécessairement pour toute l&#39;histoire du véhicule.\\n4. Une seule possession principale active par véhicule à un instant donné.\\n5. Une opération validée n&#39;est jamais écrasée : toute correction crée une nouvelle trace.\\n6. Les références métier doivent être uniques, y compris pour les créations hors-ligne.\&quot; as REGLES\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tDB_KqVmMwBC0XS5eczD-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fillColor=#FFFEFB;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
