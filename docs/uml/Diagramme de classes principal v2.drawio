        <UserObject label="" plantUmlId="vis_11" plantUmlBaseStyle="ellipse;fillColor=none;strokeColor=#038048;strokeWidth=1;movable=0;connectable=0;" plantUmlBaseValue="" id="tDB_KqVmMwBC0XS5eczD-6">
          <mxCell parent="tDB_KqVmMwBC0XS5eczD-5" style="ellipse;fillColor=none;strokeColor=#038048;strokeWidth=1;movable=0;connectable=0;" vertex="1">
            <mxGeometry height="6" width="6" x="8" y="5.244999999999999" as="geometry" />
