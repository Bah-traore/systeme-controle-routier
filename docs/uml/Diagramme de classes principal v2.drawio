          <mxCell parent="tDB_KqVmMwBC0XS5eczD-3" style="ellipse;fillColor=#ADD1B2;strokeColor=#181818;fontSize=13;fontStyle=1;fontColor=#000000;movable=0;connectable=0;" vertex="1">
            <mxGeometry height="22" width="22" x="55.45080000000001" y="5" as="geometry" />
