# ============================================================
# Système de Contrôle Routier - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Django
SECRET_KEY=replace-with-a-random-secret-key-before-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite avec support géographique SpatiaLite
DATABASE_URL=sqlite:///db.sqlite3
SPATIALITE_LIBRARY_PATH=mod_spatialite

# Redis (cache + Celery broker + Channels)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2

# API (origines du frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sécurité HTTPS (laisser False en développement local)
SECURE_SSL_REDIRECT=False

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Services nationaux externes
FICHIER_NATIONAL_IMMAT_URL=https://api.immatriculation.ml/v1
FICHIER_NATIONAL_IMMAT_API_KEY=
BASE_ASSURANCES_URL=https://api.assurances.ml/v1
BASE_ASSURANCES_API_KEY=
VISITES_TECHNIQUES_URL=https://api.visites.ml/v1
VISITES_TECHNIQUES_API_KEY=

# Stockage fichiers
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Sentry (monitoring en production)
SENTRY_DSN=

# HSM/KMS (Phase 6)
HSM_ENABLED=False
HSM_LIBRARY_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_PIN=

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@controle-routier.ml

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
